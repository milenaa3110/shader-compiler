# matrix_fs.src — matrix-bound fragment animation for the fragment benchmark.
#
# Every other animation in the benchmark is transcendental- or branch-bound; this
# one is deliberately dominated by the matrix lowering path, so the numbers say
# something about mat3 codegen rather than about sin/cos throughput. Per pixel it
# does two mat3*mat3 products, an inverse (adjugate expansion — the most
# expensive matrix builtin), a transpose, a determinant, and three mat3*vec3
# products, all with a per-pixel-varying matrix so nothing can be hoisted out.
#
# matdemo_vs covers the same builtins for spirv-val but is a vertex shader that
# runs a few thousand times; this runs them once per pixel.

uniform float uTime;
in vec2 vUV;
out vec4 FragColor;

@entry @stage(fragment)
fn void main() {
    float t = uTime * 0.6;

    # ── Per-pixel basis: the angle depends on the pixel, so the matrices below
    # are not loop-invariant and survive to codegen.
    float r  = length(vUV - vec2(0.5, 0.5));
    float a  = t + r * 3.0;
    float ca = cos(a);
    float sa = sin(a);
    float cb = cos(t * 0.7 + vUV.x * 2.0);
    float sb = sin(t * 0.7 + vUV.x * 2.0);

    mat3 rz = mat3(vec3( ca,  sa, 0.0),
                   vec3(-sa,  ca, 0.0),
                   vec3(0.0, 0.0, 1.0));
    mat3 ry = mat3(vec3( cb, 0.0, -sb),
                   vec3(0.0, 1.0, 0.0),
                   vec3( sb, 0.0,  cb));

    # Non-uniform scale keeps the matrix away from orthonormal, so `inverse` is
    # not just a transpose and the adjugate path actually matters.
    mat3 scale = mat3(vec3(1.0 + 0.35 * sb, 0.0, 0.0),
                      vec3(0.0, 1.0 + 0.35 * sa, 0.0),
                      vec3(0.0, 0.0, 1.0));

    mat3 M = rz * ry * scale;

    # ── Transform the pixel through the chain ────────────────────────────────
    vec3 p = vec3(vUV.x - 0.5, vUV.y - 0.5, 0.5);
    vec3 q = M * p;

    # Normal matrix: inverse-transpose, the standard reason a shader needs both.
    mat3 Nm = transpose(inverse(M));
    vec3 n  = normalize(Nm * vec3(0.0, 0.0, 1.0));

    # Determinant modulates the pattern, so the value is observable and cannot
    # be dead-coded away.
    float det = determinant(M);

    # ── Shade ────────────────────────────────────────────────────────────────
    vec3 lightDir = normalize(vec3(0.4, 0.7, 0.6));
    float diff = clamp(dot(n, lightDir), 0.0, 1.0);

    float band = sin(q.x * 14.0 + t) * cos(q.y * 14.0 - t) + 0.5 * sin(q.z * 9.0);
    float v = 0.5 + 0.5 * band;
    v = v * (0.55 + 0.45 * diff);

    float dscale = clamp(det * 0.7, 0.0, 1.5);
    float cr = v * (0.55 + 0.45 * sin(dscale * 3.1 + 0.0));
    float cg = v * (0.55 + 0.45 * sin(dscale * 3.1 + 2.1));
    float cb2 = v * (0.55 + 0.45 * sin(dscale * 3.1 + 4.2));

    # Vignette so the frame edges do not read flat.
    float vig = clamp(1.0 - r * 1.1, 0.0, 1.0);

    FragColor = vec4(clamp(cr * vig, 0.0, 1.0),
                     clamp(cg * vig, 0.0, 1.0),
                     clamp(cb2 * vig, 0.0, 1.0),
                     1.0);
}
